# Copy to .env.local. `next dev` can run keyless for Clerk; typecheck
# sets SKIP_ENV_VALIDATION=1. Import values from `@/env`, never process.env.

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Neon — pooled for the app (hostname has -pooler), direct for drizzle-kit
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# PostHog — optional until setup. Errors + product analytics, not a second Sentry.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Resend — optional until setup
RESEND_API_KEY=

# Vercel Blob — optional until setup. Create the store in the dashboard; paste the token.
BLOB_READ_WRITE_TOKEN=
