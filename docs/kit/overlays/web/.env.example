# Copy to .env.local. `next dev` can run keyless for Clerk; typecheck
# sets SKIP_ENV_VALIDATION=1. Import values from `@/env`, never process.env.

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Neon — pooled for the app (hostname has -pooler), direct for drizzle-kit
DATABASE_URL=
DATABASE_URL_UNPOOLED=
