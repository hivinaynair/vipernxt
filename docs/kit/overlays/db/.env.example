# Optional. Unset, the app runs on PGlite (WASM Postgres) in packages/db/.pglite
# — no daemon, no provisioning. Set these to point at Neon; production requires
# them, and the app refuses to start on the fallback when NODE_ENV=production.
#
# Pooled for the app, direct (no -pooler) for drizzle-kit push/studio.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
