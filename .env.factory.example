# One local source for factory credentials. Copy to .env.factory.local (ignored).
# bun run setup creates it; bun run doctor checks it without printing values.
# Guide: docs/START.md. Eve model access uses AI_GATEWAY_API_KEY, not VERCEL_TOKEN.
CURSOR_API_KEY=
AI_GATEWAY_API_KEY=
VERCEL_TOKEN=

# Your product repository and factory deployment; no account is preselected.
FACTORY_REPO=
FACTORY_BASE_BRANCH=staging
FACTORY_OWNER=
FACTORY_CALLBACK_AUDIENCE=
GITHUB_CONNECTOR=
FACTORY_PROJECT_NAME=
# Optional: link fills project/team IDs; specify them to select an existing project.
FACTORY_PROJECT_ID=
VERCEL_TEAM_ID=

# Optional Slack owner alerts and replies. All four enable interactive controls.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_OWNER_CHANNEL=
SLACK_OWNER_USER_ID=
# Alternative: outgoing text alerts only.
SLACK_OWNER_WEBHOOK=

# Optional coordinator model override; default is the tested factory model.
FACTORY_MODEL=
